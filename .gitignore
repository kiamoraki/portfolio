# dependencies
/node_modules

# Next.js
/.next/
/out/
next-env.d.ts

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
.pnpm-debug.log*

# Local env files
.env*.local
.env

# Vercel
.vercel

# Old website archives — too big + contain nested .git/node_modules/build artifacts.
# Decide later: move just the built _site/ of each into public/sites/, then unignore.
/sites/

# Source video files (mirrors .vercelignore — too big for GitHub, not used by site)
*.mov
*.MOV
*.mp4
*.MP4
*.m4v

# Generated on every build by scripts/build-image-manifest.mjs
/lib/image-manifest.json

# Generated on every build by scripts/extract-gif-first-frames.mjs —
# first-frame PNG placeholders shown behind heavy animated GIFs.
# PNG (not JPEG) so transparent GIFs keep their alpha — JPEG would
# flatten transparency to black and "flash" black before each GIF
# finishes loading.
/public/img/icons/*.first.png

# Claude local state
.claude/

# CV data lives in a separate PRIVATE repo (~/Dev/cv). This is a
# defensive belt so nothing personal (phone number, home address,
# unlisted employment history) ever accidentally reaches the public
# portfolio remote if it lands in a ./cv/ folder here.
/cv/

